# Free-tier demo deployment ONLY (Render's free web service — one container,
# no separate nginx/PHP-FPM split like the real docker-compose.yml topology).
# SQLite instead of MySQL, `php artisan serve` instead of nginx+FPM, sync
# queue instead of a worker process — all because a single free web service
# is one container with ephemeral disk, not the SRS §25 architecture. See
# PRODUCTION_READINESS.md for why this isn't the documented production setup.
FROM php:8.4-cli

RUN apt-get update && apt-get install -y \
    git unzip libzip-dev libpng-dev libonig-dev libsqlite3-dev sqlite3 \
    && docker-php-ext-install pdo_sqlite zip gd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

COPY . .
RUN composer dump-autoload --optimize \
    && mkdir -p database \
    && touch database/database.sqlite \
    && chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache /var/www/database

# Render injects $PORT via the environment, not a committed .env file (there
# isn't one in the image — .dockerignore excludes it). `key:generate --force`
# needs a physical .env to write into, which doesn't exist here, so `--show`
# is used instead: prints a fresh key without touching disk, exported
# straight into this boot's process environment. Regenerated every boot —
# the disk (and anything encrypted with the previous key) doesn't survive a
# redeploy anyway on the free tier, so there's nothing to preserve.
CMD ["sh", "-c", "export APP_KEY=$(php artisan key:generate --show) && php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=${PORT:-8080}"]
