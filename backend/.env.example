APP_NAME=MSIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SRS §18.3: MySQL/InnoDB/utf8mb4 is the mandated database (Official Requirement - Report).
# Host "mysql" matches the docker-compose service name (SRS §25.2). For local-without-Docker
# development, override DB_HOST to 127.0.0.1 in a local .env (never commit that override).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=msis
DB_USERNAME=msis
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SRS SEC-20/§17.4: Sanctum token TTL, minutes (12h). Custom config read by config/msis.php.
SANCTUM_TOKEN_EXPIRATION_MINUTES=720

# SRS §21.1: self-hosted Laravel Reverb (per Gap Analysis D-03's recommendation).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=msis
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# SRS §17.9/D-27b/D-28: Redis backs cache, queue, and rate limiting uniformly.
CACHE_STORE=redis
CACHE_PREFIX=msis_cache

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@msis.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SRS §22: MSIS-specific file-upload/rate-limit tunables (config/msis.php).
MSIS_MAX_UPLOAD_MB=10
MSIS_MAX_ATTACHMENTS_PER_TICKET=5

FRONTEND_APP_SCHEME=msisapp

# SRS §20.1/§21.1: path to the Firebase service-account JSON. Absent => push
# safely no-ops; in-app notifications still work either way.
FCM_CREDENTIALS_PATH=
